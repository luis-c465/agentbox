#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -un)" != vscode ]]; then
    echo "Run agentbox-cua-serve as vscode, not root" >&2
    exit 1
fi

mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# Serialize creation and probe the bus rather than trusting a stale socket.
exec 9>"$XDG_RUNTIME_DIR/session-bus.lock"
flock 9
if ! dbus-send --session --print-reply --reply-timeout=2000 \
    --dest=org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus.ListNames >/latest/null 2>&1; then
    rm -f "$XDG_RUNTIME_DIR/session-bus"
    dbus-daemon --session --fork --address="$DBUS_SESSION_BUS_ADDRESS" --nopidfile
fi
flock -u 9
exec 9>&-

if ! xdpyinfo -display "$DISPLAY" >/latest/null 2>&1; then
    echo "Desktop unavailable at $DISPLAY; start Agentbox VNC first" >&2
    exit 1
fi

exec cua-driver serve "$@"
